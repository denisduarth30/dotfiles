{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "VSCode Dark+",
  "author": "Inspirado no VSCode Dark+ (Microsoft)",
  "themes": [
    {
      "name": "VSCode Dark+",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",

        "background": "#252526",
        "surface.background": "#252526",
        "elevated_surface.background": "#2d2d30",
        "panel.background": "#252526",

        "editor.background": "#1e1e1e",
        "editor.gutter.background": "#1e1e1e",
        "editor.subheader.background": "#252526",
        "editor.active_line.background": "#ffffff0d",
        "editor.highlighted_line.background": "#ffffff0d",
        "editor.line_number": "#858585",
        "editor.active_line_number": "#c6c6c6",
        "editor.invisible": "#3b3b3b",
        "editor.wrap_guide": "#404040",
        "editor.active_wrap_guide": "#707070",

        "editor.foreground": "#d4d4d4",
        "text": "#d4d4d4",
        "text.muted": "#858585",
        "text.placeholder": "#a6a6a6",
        "text.disabled": "#6b6b6b",
        "text.accent": "#569cd6",

        "border": "#3e3e42",
        "border.variant": "#2d2d30",
        "border.focused": "#007fd4",
        "border.selected": "#007fd4",
        "border.transparent": "#00000000",
        "border.disabled": "#3e3e42",

        "tab_bar.background": "#2d2d2d",
        "tab.inactive_background": "#2d2d2d",
        "tab.active_background": "#1e1e1e",
        "tab.active_foreground": "#ffffff",
        "tab.inactive_foreground": "#969696",

        "toolbar.background": "#252526",
        "title_bar.background": "#3c3c3c",
        "title_bar.inactive_background": "#3c3c3c",

        "status_bar.background": "#007acc",
        "status_bar.foreground": "#ffffff",
        "status_bar.border": "#007acc",

        "sidebar.background": "#252526",
        "sidebar.border": "#252526",

        "panel.border": "#252526",
        "panel.focused_border": "#007fd4",

        "pane.focused_border": "#007fd4",

        "scrollbar.thumb.background": "#424242cc",
        "scrollbar.thumb.hover_background": "#626262cc",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#1e1e1e",
        "scrollbar.track.border": "#2d2d2d",

        "search.match_background": "#9e6a0340",
        "search.match_border": "#d7992880",

        "selection.background": "#264f78",
        "editor.selection.background": "#264f78",

        "editor.document_highlight.read_background": "#add6ff26",
        "editor.document_highlight.write_background": "#add6ff26",

        "link_text.hover": "#4daafc",

        "conflict": "#e2c08d",
        "conflict.background": "#9e6a0340",
        "conflict.border": "#9e6a03",
        "created": "#4ec994",
        "created.background": "#4ec99420",
        "created.border": "#4ec994",
        "deleted": "#f88070",
        "deleted.background": "#f8807020",
        "deleted.border": "#f88070",
        "error": "#f44747",
        "error.background": "#f4474720",
        "error.border": "#f44747",
        "hidden": "#858585",
        "hidden.background": "#252526",
        "hidden.border": "#858585",
        "hint": "#eeeeee",
        "hint.background": "#eeeeee10",
        "hint.border": "#eeeeee",
        "ignored": "#858585",
        "info": "#75beff",
        "info.background": "#75beff20",
        "info.border": "#75beff",
        "modified": "#e2c08d",
        "modified.background": "#e2c08d20",
        "modified.border": "#e2c08d",
        "predictive": "#567e6a",
        "predictive.background": "#567e6a20",
        "predictive.border": "#567e6a",
        "renamed": "#73c991",
        "renamed.background": "#73c99120",
        "renamed.border": "#73c991",
        "success": "#73c991",
        "success.background": "#73c99120",
        "success.border": "#73c991",
        "unreachable": "#858585",
        "unreachable.background": "#85858520",
        "unreachable.border": "#858585",
        "warning": "#cca700",
        "warning.background": "#cca70020",
        "warning.border": "#cca700",

        "terminal.background": "#1e1e1e",
        "terminal.foreground": "#cccccc",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#858585",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.bright_black": "#666666",
        "terminal.ansi.white": "#d4d4d4",
        "terminal.ansi.bright_white": "#e5e5e5",
        "terminal.ansi.red": "#cd3131",
        "terminal.ansi.bright_red": "#f14c4c",
        "terminal.ansi.green": "#0dbc79",
        "terminal.ansi.bright_green": "#23d18b",
        "terminal.ansi.yellow": "#e5e510",
        "terminal.ansi.bright_yellow": "#f5f543",
        "terminal.ansi.blue": "#2472c8",
        "terminal.ansi.bright_blue": "#3b8eea",
        "terminal.ansi.magenta": "#bc3fbc",
        "terminal.ansi.bright_magenta": "#d670d6",
        "terminal.ansi.cyan": "#11a8cd",
        "terminal.ansi.bright_cyan": "#29b8db",

        "syntax": {
          "attribute": { "color": "#9cdcfe" },
          "boolean": { "color": "#569cd6" },
          "comment": { "color": "#6a9955", "font_style": "italic" },
          "comment.doc": { "color": "#6a9955", "font_style": "italic" },
          "constant": { "color": "#4fc1ff" },
          "constructor": { "color": "#4ec9b0" },
          "embedded": { "color": "#d4d4d4" },
          "emphasis": { "color": "#d4d4d4", "font_style": "italic" },
          "emphasis.strong": { "color": "#d4d4d4", "font_weight": 700 },
          "enum": { "color": "#4ec9b0" },
          "function": { "color": "#dcdcaa" },
          "function.builtin": { "color": "#dcdcaa" },
          "function.definition": { "color": "#dcdcaa" },
          "hint": { "color": "#eeeeee" },
          "keyword": { "color": "#569cd6" },
          "label": { "color": "#c8c8c8" },
          "link_text": { "color": "#3794ff", "font_style": "italic" },
          "link_uri": { "color": "#3794ff" },
          "number": { "color": "#b5cea8" },
          "operator": { "color": "#d4d4d4" },
          "predictive": { "color": "#567e6a", "font_style": "italic" },
          "preproc": { "color": "#c586c0" },
          "primary": { "color": "#d4d4d4" },
          "property": { "color": "#9cdcfe" },
          "punctuation": { "color": "#d4d4d4" },
          "punctuation.bracket": { "color": "#d4d4d4" },
          "punctuation.delimiter": { "color": "#d4d4d4" },
          "punctuation.list_marker": { "color": "#6796e6" },
          "punctuation.special": { "color": "#569cd6" },
          "string": { "color": "#ce9178" },
          "string.doc": { "color": "#ce9178" },
          "string.escape": { "color": "#d7ba7d" },
          "string.regex": { "color": "#d16969" },
          "string.special": { "color": "#d7ba7d" },
          "string.special.symbol": { "color": "#ce9178" },
          "tag": { "color": "#569cd6" },
          "text.literal": { "color": "#ce9178" },
          "title": { "color": "#569cd6", "font_weight": 700 },
          "type": { "color": "#4ec9b0" },
          "type.builtin": { "color": "#4ec9b0" },
          "type.interface": { "color": "#4ec9b0" },
          "type.super": { "color": "#4ec9b0" },
          "variable": { "color": "#9cdcfe" },
          "variable.member": { "color": "#9cdcfe" },
          "variable.special": { "color": "#4fc1ff" },
          "variant": { "color": "#4ec9b0" }
        }
      }
    }
  ]
}
