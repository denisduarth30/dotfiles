{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "default",
    "width": 18,
    "padding": {
      "top": 1,
      "right": 3,
    },
    "color": {
      "1": "#86BE43",
      "2": "#FFFFFF",
    },
  },

  "display": {
    "separator": ": ",
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "#86BE43",
        "at": "#86BE43",
        "host": "#86BE43",
      },
    },

    {
      "type": "datetime",
      "key": "Date & Time",
      "keyColor": "#86BE43",
      "padding": {
        "top": 1,
        "right": 5,
      },
    },

    "break",

    { "type": "os", "key": "OS", "keyColor": "#86BE43" },
    { "type": "host", "key": "Host", "keyColor": "#86BE43" },
    { "type": "kernel", "key": "Kernel", "keyColor": "#86BE43" },
    { "type": "uptime", "key": "Uptime", "keyColor": "#86BE43" },

    "break",

    { "type": "shell", "key": "Shell", "keyColor": "#86BE43" },
    { "type": "terminal", "key": "Terminal", "keyColor": "#86BE43" },

    "break",

    { "type": "display", "key": "Display", "keyColor": "#86BE43" },
    { "type": "cpu", "key": "CPU", "keyColor": "#86BE43" },
    { "type": "gpu", "key": "GPU", "keyColor": "#86BE43" },

    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#86BE43",
    },

    {
      "type": "disk",
      "key": "Disk",
      "folders": "C:\\",
      "keyColor": "#86BE43",
    },

    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "#86BE43",
    },

    { "type": "localip", "key": "IP", "keyColor": "#86BE43" },

    "break",

    {
      "type": "colors",
      "symbol": "circle",
    },

    "break",
    {
      "type": "media",
      "key": "Song",
      "format": "{title}",
    },
    "break",
    {
      "type": "sound",
      "key": "Vol",
      "keyColor": "#86BE43",
    },
  ],
}
