configuration {
    font: "CommitMono Nerd Font 15";
    modi: "drun,web:rofi-web.fish,run:rofi-run.fish,ani-cli:rofi-ani-cli.fish,powermenu:rofi-powermenu.fish";
    display-drun: "";
    display-window: "🪟​";
    display-filebrowser: "🗂️​";
    display-web: "󰖟";
    display-run: "";
    display-combi: "󰣭";
    display-ani-cli: "";
    show-icons: true;
    drun-display-format: "{icon} {name}";
    web-display-format: "{name}";
    disable-history: false;
    terminal: "alacritty";
    matching: "normal";
    sorting-method: "fzf";
}
