configuration {
    font: "CommitMono Nerd Font 14";
    modi: "drun,web:rofi-search.fish, run:rofi-run.fish, ani-cli:rofi-ani-cli.fish";
    display-drun: "";
    display-window: "🪟​";
    display-filebrowser: "🗂️​";
    display-web: "󰖟";
    display-run: "";
    display-combi: "";
    display-ani-cli: "󰋖";
    show-icons: true;
    drun-display-format: "{icon} {name}";
    web-display-format: "{name}";
    disable-history: false;
    terminal: "kitty";
}
