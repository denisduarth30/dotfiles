/* /home/denis/dotfiles/rofi/.config/rofi/themes/mint-dark.rasi */

* {
    font:   "CommitMono Nerd Font 14";
    bg0:     #27272B;
    bg1:     #36363A;
    fg0:     #e0e0e0;
    fg-dim:  #5E5E60;
    placeholder-color: #454549;
    border-color:     transparent;
    accent-color:     #A9A9B1;
    urgent-color:     #111111;
    background-color:   transparent;
    text-color:         @fg0;
    margin:     0;
    padding:    0;
    spacing:    0;
    radius: 20px;
}
window {
    location:   center;
    width:      500;
    background-color:   @bg0;
    border-radius:      @radius;
}
inputbar {
    spacing:    20px;
    padding:    20px;
    background-color:   @bg0;
    border: 0px;
    border-radius:      @radius;
}
prompt, entry {
    vertical-align: 0.5;
}
prompt {
    text-color: @placeholder-color;
    enabled: true;
}
textbox {
    padding:            5px;
    background-color:   @bg1;
}
listview {
    fixed-height: false;
    dynamic: true;
    scrollbar: true;
    spacing: -2px;
    padding: 5px;
    lines: 6;
}
entry {
    text-color: #ffffff;
    placeholder-color: @placeholder-color;
    placeholder: "teste fixo";
}
element {
    /* Padding consistente para manter tudo alinhado */
    padding:    9px 15px 9px 15px;
    spacing:    10px; /* Um pouco mais de espaço entre o ícone e o texto */
}
element normal normal {
    text-color: @fg-dim;
}
element normal urgent {
    text-color: @urgent-color;
}
element normal active {
    text-color: @accent-color;
}
element alternate normal {
    text-color: @fg-dim;
}
element alternate active {
    text-color: @accent-color;
}
element selected {
    /* Removido o padding: 7px que quebrava o alinhamento */
    text-color: #ffffff;
}
element selected normal, element selected active {
    background-color:   @bg1;
    border-radius:      @radius;
    text-color:         #ffffff;
}
element selected urgent {
    background-color:   @urgent-color;
}
element-icon {
    size:               1.4em;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}
element-text {
    font:               "CommitMono Nerd Font 12";
    text-color:         inherit;
    highlight:          bold;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}
element-text selected {
    font:               "CommitMono Nerd Font Bold 12";
    text-color:         inherit;
}
