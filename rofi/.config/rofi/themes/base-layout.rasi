/* base-layout.rasi */

* {
    window-width:       480px;
    font:               "Hack Nerd Font 17";
    background-color:   transparent;
    text-color:         @fg0;
    margin:             0;
    padding:            0;
    spacing:            0;
    radius:             11px;
    element-radius:     8px;
    element-spacing:    3px;
    main-font:          "Hack Nerd Font 12.5";
}

window {
    location:           center;
    anchor:             center;
    height:             inherit;
    width:              @window-width;
    background-color:   @bg0;
    border-radius:      @radius;
    border-color:       @border-color;
    border:             1px;
}

inputbar {
    spacing:            15px 15px 0px 23px;
    padding:            13px;
    background-color:   @bg0;
    border-radius:      @radius;
}

prompt, entry, element-icon, element-text {
    vertical-align:     0.5;
}
prompt {
    text-color:         @placeholder-color;
    enabled:            true;
}

textbox {
    padding:            5px;
    background-color:   @bg1;
    cursor-color:       #000000;
    cursor-width:       1px;
}

listview {
    require-input:                  true;
    fixed-height:                   false;
    fixed-columns:                  true;
    enabled:                        true;
    columns:                        1;
    lines:                          5;
    cycle:                          true;
    dynamic:                        true;
    scrollbar:                      false;
    layout:                         vertical;
    spacing:                        @element-spacing;
    padding:                        4px 7px 7px 7px;
    border-radius:                  @radius;
}

entry {
    text-color:         @entry-fg;
    font:               inherit;
    placeholder-color:  @placeholder-color;
    placeholder:        "";
    cursor: text;
}

element {
    padding:            7px 15px 7px 15px;
    spacing:            @element-spacing;
}

element normal normal     { text-color: @fg-dim; }
element normal urgent     { text-color: @urgent-color; }
element normal active     { text-color: @accent-color; }
element alternate normal  { text-color: @fg-dim; }
element alternate active  { text-color: @accent-color; }
element selected          { text-color: @selected-fg; }

element selected normal, element selected active {
    background-color:   @bg1;
    border-radius:      @element-radius;
    text-color:         @selected-fg;
}

element selected normal {
    border:             1px;
    border-color:       @selected-border-color;
}

element selected urgent { background-color: @urgent-color; }

element-icon {
    size:               1em;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

element-text {
    font:               @main-font;
    text-color:         inherit;
    highlight:          bold underline;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

element-text selected {
    font:               @main-font;
    text-color:         inherit;
}

#case-indicator {
    enabled: false;
}
